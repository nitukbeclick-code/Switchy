{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // web/lib/__tests__/crm-parity.test.ts deliberately imports the Deno module
    // supabase/functions/crm-api/crm_logic.ts, to pin this console's validation
    // vocabulary to the server's. Deno REQUIRES the .ts extension on its own
    // relative imports, so once that module imports anything, tsc following it
    // hits TS5097. This flag lets tsc resolve those specifiers; it is safe
    // because noEmit is true above, and it changes nothing at runtime — the app
    // itself still imports extensionless, as every file here does.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-gate/types/**/*.ts",
    ".next-gate/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
